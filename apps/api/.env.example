# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=storeprint
DB_USER=storeprint
DB_PASSWORD=storeprint_pass

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_pass

# JWT
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# MinIO
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=storeprint_admin
MINIO_SECRET_KEY=storeprint_minio_pass
MINIO_BUCKET=storeprint

# Meilisearch
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=meili_master_key_change_me

# Ntfy (push notifications)
NTFY_HOST=http://ntfy:80
NTFY_TOPIC_PREFIX=storeprint

# Encryption (for integration credentials)
ENCRYPTION_KEY=32_char_encryption_key_change_me
